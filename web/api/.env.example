# Copy to .env (never commit .env). Values are placeholders.
CLAUDE_ADS_REPO_ROOT=../..
CLAUDE_ADS_DATA_DIR=./data
CLAUDE_ADS_DATABASE_URL=sqlite:///./data/claude-ads-web.db
CLAUDE_ADS_SESSION_SECRET=change-me-generate-a-long-random-string
CLAUDE_ADS_LOCALE=zh-CN
CLAUDE_ADS_CORS_ORIGINS=http://localhost:3000

# Anthropic worker runner (secret value lives in the environment only)
ANTHROPIC_API_KEY=
CLAUDE_ADS_WORKER_MODEL=claude-sonnet-5-5
CLAUDE_ADS_WORKER_MAX_TOKENS=8000
CLAUDE_ADS_RUN_TOKEN_BUDGET=200000

# Meta connections reference env var names via secret_ref, e.g. META_ACCESS_TOKEN_CLIENT_A
META_GRAPH_API_VERSION=v23.0

# Initial admin bootstrap (used once by `python -m app.bootstrap`)
CLAUDE_ADS_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
CLAUDE_ADS_BOOTSTRAP_ADMIN_PASSWORD=
